# ==============================================================================
# .dockerignore — Nilus Lab / Zenith Platform
# Reduces Docker build context by excluding dev-only, temp, and secret files.
# CRITICAL: Do NOT exclude files required by bridge_server.py at runtime.
# ==============================================================================

# ── Version Control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Secrets & Environment ────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Python Caches ────────────────────────────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# ── Virtual Environments ─────────────────────────────────────────────────────
.venv
venv
env

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.agent

# ── Notebooks (not needed at runtime) ────────────────────────────────────────
*.ipynb
.ipynb_checkpoints

